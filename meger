import java.io.BufferedReader;
import java.io.InputStreamReader;
import java.util.*;

public class GKEProjectNamespaceFetcher {

    public static void main(String[] args) {
        // 你可以根据需要添加多个项目 ID
        List<String> projectIds = Arrays.asList("project-1-id", "project-2-id");

        for (String projectId : projectIds) {
            System.out.println("============== Project: " + projectId + " ==============");
            try {
                List<ClusterInfo> clusters = getClusters(projectId);
                for (ClusterInfo cluster : clusters) {
                    System.out.println("-- Cluster: " + cluster.name + " (" + cluster.location + ")");

                    // 设置 kubectl 凭据
                    Process credProcess = new ProcessBuilder(
                            "gcloud", "container", "clusters", "get-credentials",
                            cluster.name,
                            "--region", cluster.location,
                            "--project", projectId
                    ).start();
                    credProcess.waitFor();

                    // 获取 namespace
                    Process nsProcess = new ProcessBuilder(
                            "kubectl", "get", "namespaces",
                            "-o", "jsonpath={.items[*].metadata.name}"
                    ).start();
                    BufferedReader nsReader = new BufferedReader(new InputStreamReader(nsProcess.getInputStream()));
                    String nsLine = nsReader.readLine();
                    System.out.println("Namespaces: " + nsLine);
                    nsProcess.waitFor();
                }
            } catch (Exception e) {
                System.err.println("Error processing project " + projectId + ": " + e.getMessage());
            }
        }
    }

    static List<ClusterInfo> getClusters(String projectId) throws Exception {
        List<ClusterInfo> clusters = new ArrayList<>();
        Process process = new ProcessBuilder(
                "gcloud", "container", "clusters", "list",
                "--project", projectId,
                "--format=value(name,location)"
        ).start();

        BufferedReader reader = new BufferedReader(new InputStreamReader(process.getInputStream()));
        String line;
        while ((line = reader.readLine()) != null) {
            String[] parts = line.trim().split("\\s+");
            if (parts.length == 2) {
                clusters.add(new ClusterInfo(parts[0], parts[1]));
            }
        }
        process.waitFor();
        return clusters;
    }

    static class ClusterInfo {
        String name;
        String location;

        ClusterInfo(String name, String location) {
            this.name = name;
            this.location = location;
        }
    }
}
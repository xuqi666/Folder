import com.fasterxml.jackson.databind.*;
import com.fasterxml.jackson.databind.node.*;

import java.util.*;

public class JsonRoleMergerTwoOnly {

    private static final ObjectMapper mapper = new ObjectMapper();

    /**
     * 合并两个 JSON 字符串，按 a.sa1 / sa2 下的 role 合并 members
     */
    public static ObjectNode mergeTwoJsonByRole(String json1, String json2) throws Exception {
        JsonNode root1 = mapper.readTree(json1);
        JsonNode root2 = mapper.readTree(json2);

        ObjectNode result = mapper.createObjectNode();
        ObjectNode resultA = mapper.createObjectNode();

        // 找到 a 下的每个 key，例如 sa1、sa2
        Set<String> allKeys = new LinkedHashSet<>();
        JsonNode a1 = root1.path("a");
        JsonNode a2 = root2.path("a");

        a1.fieldNames().forEachRemaining(allKeys::add);
        a2.fieldNames().forEachRemaining(allKeys::add);

        for (String saKey : allKeys) {
            JsonNode arr1 = a1.path(saKey);
            JsonNode arr2 = a2.path(saKey);

            Map<String, Set<String>> roleMap = new LinkedHashMap<>();
            mergeRoleMembers(arr1, roleMap);
            mergeRoleMembers(arr2, roleMap);

            // 构造数组
            ArrayNode mergedArray = mapper.createArrayNode();
            for (Map.Entry<String, Set<String>> entry : roleMap.entrySet()) {
                ObjectNode roleObj = mapper.createObjectNode();
                roleObj.put("role", entry.getKey());

                ArrayNode membersArray = mapper.createArrayNode();
                entry.getValue().forEach(membersArray::add);
                roleObj.set("members", membersArray);

                mergedArray.add(roleObj);
            }

            resultA.set(saKey, mergedArray);
        }

        result.set("a", resultA);
        return result;
    }

    private static void mergeRoleMembers(JsonNode arr, Map<String, Set<String>> roleMap) {
        if (!arr.isArray()) return;

        for (JsonNode obj : arr) {
            String role = obj.path("role").asText();
            JsonNode members = obj.path("members");
            if (!members.isArray()) continue;

            roleMap.computeIfAbsent(role, k -> new LinkedHashSet<>());
            for (JsonNode member : members) {
                roleMap.get(role).add(member.asText());
            }
        }
    }
}